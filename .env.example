# ================================================
# khelbiNaki Frontend Environment Variables
# ================================================
# Copy this file to .env.local for local development
# Add these variables in Vercel Dashboard for production

# ================================================
# API Configuration (REQUIRED)
# ================================================
# Backend API URL - Update based on environment
# Local: http://localhost:9000/api/v1
# Production: https://turf-booking-system-backend.onrender.com/api/v1
VITE_API_URL=http://localhost:9000/api/v1

# ================================================
# App Configuration
# ================================================
# Your frontend application URL
VITE_APP_URL=http://localhost:5173

# ================================================
# Payment Gateway Configuration
# ================================================
# SSL Commerz Store ID for payment processing
VITE_SSL_STORE_ID=your-ssl-store-id-here

# ================================================
# Feature Flags (Optional)
# ================================================
# Enable React Query DevTools (should be false in production)
VITE_ENABLE_DEVTOOLS=true

# Enable Analytics tracking (set to true for production)
VITE_ENABLE_ANALYTICS=false

# Enable Progressive Web App features
VITE_ENABLE_PWA=false

# ================================================
# Development Tools
# ================================================
# Enable detailed logging in development
VITE_ENABLE_LOGGING=true
