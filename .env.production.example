# Production Environment Variables for Vercel

# ⚠️ DO NOT COMMIT THIS FILE!
# This is a template. Add these variables in Vercel Dashboard.

# API Configuration
VITE_API_URL=https://turf-booking-system-backend.onrender.com/api/v1

# App Configuration  
VITE_APP_URL=https://your-app-name.vercel.app

# SSL Store Configuration
VITE_SSL_STORE_ID=your-production-ssl-store-id

# Development Tools (disable in production)
VITE_ENABLE_DEVTOOLS=false

# Optional: Analytics
# VITE_ENABLE_ANALYTICS=true

# Optional: PWA
# VITE_ENABLE_PWA=true
